[
  {
    "signature": "cancel_booking(uuid)",
    "definition": "CREATE OR REPLACE FUNCTION public.cancel_booking(p_booking_id uuid)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nDECLARE\r\n    v_user_id uuid;\r\nBEGIN\r\n\r\n    v_user_id := auth.uid();\r\n\r\n    UPDATE public.bookings\r\n    SET\r\n        status = 'cancelled_by_user',\r\n        updated_at = now()\r\n    WHERE id = p_booking_id\r\n    AND user_id = v_user_id\r\n    AND status = 'active';\r\n\r\n    IF NOT FOUND THEN\r\n        RAISE EXCEPTION 'Reserva no encontrada o no cancelable';\r\n    END IF;\r\n\r\n    RETURN true;\r\n\r\nEND;\r\n$function$\n"
  },
  {
    "signature": "create_booking(bigint,date)",
    "definition": "CREATE OR REPLACE FUNCTION public.create_booking(p_slot_id bigint, p_booking_date date)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\ndeclare\r\n  v_booking_id uuid;\r\n  v_user_id uuid;\r\n  v_active_count integer;\r\n  v_same_day_count integer;\r\n  v_same_slot_count integer;\r\nbegin\r\n  v_user_id := auth.uid();\r\n\r\n  if v_user_id is null then\r\n    raise exception 'Usuario no autenticado';\r\n  end if;\r\n\r\n  if not exists (\r\n    select 1\r\n    from public.profiles\r\n    where id = v_user_id\r\n      and active = true\r\n  ) then\r\n    raise exception 'Usuario desactivado';\r\n  end if;\r\n\r\n  perform pg_advisory_xact_lock(\r\n    hashtext(p_booking_date::text || '-' || p_slot_id::text)\r\n  );\r\n\r\n  if exists (\r\n    select 1\r\n    from public.bookings\r\n    where booking_date = p_booking_date\r\n      and slot_id = p_slot_id\r\n      and status = 'maintenance'\r\n  ) then\r\n    raise exception 'La franja no está disponible por mantenimiento';\r\n  end if;\r\n\r\n  if exists (\r\n    select 1\r\n    from public.bookings\r\n    where booking_date = p_booking_date\r\n      and slot_id = p_slot_id\r\n      and status = 'active'\r\n  ) then\r\n    raise exception 'La pista ya está reservada';\r\n  end if;\r\n\r\n  select count(*)\r\n    into v_active_count\r\n  from public.bookings\r\n  where user_id = v_user_id\r\n    and status = 'active';\r\n\r\n  if v_active_count >= 3 then\r\n    raise exception 'Máximo 3 reservas activas';\r\n  end if;\r\n\r\n  select count(*)\r\n    into v_same_day_count\r\n  from public.bookings\r\n  where user_id = v_user_id\r\n    and booking_date = p_booking_date\r\n    and status = 'active';\r\n\r\n  if v_same_day_count > 0 then\r\n    raise exception 'Ya existe una reserva ese día';\r\n  end if;\r\n\r\n  select count(*)\r\n    into v_same_slot_count\r\n  from public.bookings\r\n  where user_id = v_user_id\r\n    and slot_id = p_slot_id\r\n    and status = 'active';\r\n\r\n  if v_same_slot_count > 0 then\r\n    raise exception 'No puede repetir horario';\r\n  end if;\r\n\r\n  insert into public.bookings (\r\n    user_id,\r\n    booking_date,\r\n    slot_id,\r\n    status\r\n  )\r\n  values (\r\n    v_user_id,\r\n    p_booking_date,\r\n    p_slot_id,\r\n    'active'\r\n  )\r\n  returning id into v_booking_id;\r\n\r\n  return v_booking_id;\r\nend;\r\n$function$\n"
  }
]

